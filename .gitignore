# ============================================================
# 不入库的内容：本地归档 / 临时 / 缓存 / 备份
# 这些保留在本地磁盘，不随仓库分发。如需公开，去掉对应忽略项即可。
# ============================================================
archive/

# Web 临时 / 调试残留（含可能被进程锁定的验证用 xlsm）
web/_tmp/
web/_scratch/
web/_diffwork/

# ---------- ONNX 运行时缓存（约 14MB，可重建：构建时加 --force-download ----------
web/运行时/

# ---------- 非构建必需的大字体（约 20MB，思源黑体）----------
SourceHanSansSC-Regular.ttf

# ---------- xlsm 改动前的备份 ----------
tools/备份/

# ---------- 探针跑出来的截图 / 中间产物 ----------
web/调试/_shots/

# ---------- Python ----------
__pycache__/
*.pyc
*.pyo
*.Python

# ---------- 编辑器 / 系统 ----------
.DS_Store
desktop.ini
Thumbs.db
*.swp
*~

# ---------- Excel 临时锁文件 ----------
~$*.xlsm
~$*.xlsx

# ---------- 构建/导出遗留备份 ----------
*.bak
